// A · 清晰原生。键盘导航仍在 TextInput 上拦截，选择与执行由 Rust 决策。
import { ListView, Palette } from "std-widgets.slint";
import { CabinTheme, CabinIcon, CabinButton } from "design.slint";

export struct ResultItem {
    title: string,
    subtitle: string,
    // 结果图标（Rust 侧从图标缓存水合为位图；无图标时为零尺寸空图）。
    icon: image,
    // 无图标时的芯片字符（标题首字符大写，对齐 TS getResultIconGlyph；Rust 填）。
    glyph: string,
    // 分组头文本：非空 = 首页分组头行（不可选中/执行/固定）。
    group: string,
    // 命令 id（分组头行为空串）；执行与固定动作经 id 回 Rust 侧解析。
    command-id: string,
    // source==app && open-app → 可固定（显示固定按钮）。
    app: bool,
    // 已是固定应用收藏（含收藏命令本身）→ 不显示固定按钮。
    pinned: bool,
}

/// 首页固定磁贴：标题 + 图标 + 命令 id（点击执行经 id 回 Rust）。
export struct PinnedTile {
    title: string,
    icon: image,
    command-id: string,
}


component HomeTileFace inherits Rectangle {
    in property <PinnedTile> tile;
    in property <bool> selected;
    in property <bool> hovered;
    in property <bool> drop-target;
    height: 85px;
    border-radius: 9px;
    border-width: 1px;
    border-color: selected || drop-target ? CabinTheme.accent : hovered ? CabinTheme.line : transparent;
    background: selected || drop-target ? CabinTheme.soft : hovered ? CabinTheme.panel : transparent;
    Image {
        x: (parent.width - 32px) / 2;
        y: 10px;
        width: 32px;
        height: 32px;
        source: root.tile.icon;
        image-fit: contain;
    }
    Rectangle {
        x: 4px; y: 49px;
        width: parent.width - 8px;
        height: 32px;
        clip: true;
        Text {
            width: parent.width;
            text: root.tile.title;
            font-size: 12px;
            color: CabinTheme.text;
            wrap: word-wrap;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    if selected: Rectangle {
        x: parent.width - 10px; y: 7px;
        width: 4px; height: 4px;
        border-radius: 2px;
        background: CabinTheme.accent;
    }
}

component HomeTileView inherits Rectangle {
    in property <PinnedTile> tile;
    in property <bool> selected;
    in property <bool> drop-target;
    in property <bool> dimmed;
    in property <string> unpin-label;
    property <bool> dragged: false;
    property <PinnedTile> pressed-tile;
    callback run(string);
    callback unpin(string);
    callback begin-drag(PinnedTile, length, length);
    callback drag-moved(length, length);
    callback end-drag(length, length);
    callback cancel-drag();
    height: 85px;
    accessible-role: button;
    accessible-label: tile.title;
    accessible-action-default => { root.run(root.tile.command-id); }
    HomeTileFace {
        tile: root.tile; selected: root.selected; hovered: touch.has-hover;
        drop-target: root.drop-target; opacity: root.dimmed ? 0.35 : 1;
    }
    menu := ContextMenuArea {
        Menu {
            MenuItem { title: root.unpin-label; activated => { root.unpin(root.tile.command-id); } }
        }
        touch := TouchArea {
            mouse-cursor: root.dragged && self.pressed ? move : pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.cancel {
                    root.dragged = true;
                    root.cancel-drag();
                } else if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.dragged = true;
                    root.cancel-drag();
                    menu.show({ x: self.mouse-x, y: self.mouse-y });
                } else if event.button == PointerEventButton.left {
                    if event.kind == PointerEventKind.down {
                        root.dragged = false;
                        root.pressed-tile = root.tile;
                        root.begin-drag(root.pressed-tile, root.x + self.mouse-x, root.y + self.mouse-y);
                    } else if event.kind == PointerEventKind.up {
                        if root.dragged { root.end-drag(root.x + self.mouse-x, root.y + self.mouse-y); }
                        else { root.cancel-drag(); }
                    }
                }
            }
            moved => {
                if self.pressed && (root.dragged || abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px) {
                    root.dragged = true;
                    root.drag-moved(root.x + self.mouse-x, root.y + self.mouse-y);
                }
            }
            clicked => { if !root.dragged { root.run(root.pressed-tile.command-id); } }
        }
    }
}

component PinnedGrid inherits Rectangle {
    in property <[PinnedTile]> first-row;
    in property <[PinnedTile]> second-row;
    in property <int> selected;
    in property <string> unpin-label;
    callback run(string);
    callback unpin(string);
    callback reorder(string, string);
    in-out property <bool> drag-active: false;
    in property <int> gesture-reset;
    changed gesture-reset => { root.cancel-drag(); }
    property <PinnedTile> dragged-tile;
    property <string> drag-id: "";
    property <int> target: -1;
    property <length> drag-x;
    property <length> drag-y;
    property <length> offset-x;
    property <length> offset-y;
    property <length> cell-step: (self.width + 7px) / 5;
    height: first-row.length == 0 ? 0px : second-row.length > 0 ? 180px : 85px;
    function tile-at(index: int) -> PinnedTile {
        return index < 5 ? root.first-row[index] : root.second-row[index - 5];
    }
    function index-at(x: length, y: length) -> int {
        if x < 0px || x >= root.width || y < 0px || y >= root.height { return -1; }
        let column = floor(x / root.cell-step);
        let row = floor(y / 95px);
        if x - column * root.cell-step > root.cell-step - 7px || y - row * 95px >= 85px { return -1; }
        let index = row * 5 + column;
        return index < root.first-row.length + root.second-row.length ? index : -1;
    }
    function begin(tile: PinnedTile, x: length, y: length) {
        root.dragged-tile = tile;
        root.drag-id = tile.command-id;
        root.drag-active = false;
        root.offset-x = x - floor(x / root.cell-step) * root.cell-step;
        root.offset-y = y - floor(y / 95px) * 95px;
    }
    function move(x: length, y: length) {
        if root.drag-id == "" { return; }
        root.drag-active = true;
        root.drag-x = x - root.offset-x;
        root.drag-y = y - root.offset-y;
        root.target = root.index-at(x, y);
    }
    public function cancel-drag() {
        root.drag-active = false;
        root.drag-id = "";
        root.target = -1;
    }
    function drop(x: length, y: length) {
        let source = root.drag-id;
        let index = root.index-at(x, y);
        let target = index >= 0 ? root.tile-at(index).command-id : "";
        root.cancel-drag();
        if source != "" && target != "" && source != target { root.reorder(source, target); }
    }
    for tile[t] in root.first-row: HomeTileView {
        x: t * root.cell-step; y: 0px; width: root.cell-step - 7px;
        tile: tile; selected: root.selected == t;
        drop-target: root.drag-active && root.target == t;
        dimmed: root.drag-active && root.drag-id == tile.command-id;
        unpin-label: root.unpin-label;
        run(id) => { root.run(id); }
        unpin(id) => { root.unpin(id); }
        begin-drag(tile, x, y) => { root.begin(tile, x, y); }
        drag-moved(x, y) => { root.move(x, y); }
        end-drag(x, y) => { root.drop(x, y); }
        cancel-drag => { root.cancel-drag(); }
    }
    for tile[t] in root.second-row: HomeTileView {
        x: t * root.cell-step; y: 95px; width: root.cell-step - 7px;
        tile: tile; selected: root.selected == t + 5;
        drop-target: root.drag-active && root.target == t + 5;
        dimmed: root.drag-active && root.drag-id == tile.command-id;
        unpin-label: root.unpin-label;
        run(id) => { root.run(id); }
        unpin(id) => { root.unpin(id); }
        begin-drag(tile, x, y) => { root.begin(tile, x, y); }
        drag-moved(x, y) => { root.move(x, y); }
        end-drag(x, y) => { root.drop(x, y); }
        cancel-drag => { root.cancel-drag(); }
    }
    if root.drag-active: HomeTileFace {
        x: root.drag-x; y: root.drag-y; width: root.cell-step - 7px;
        tile: root.dragged-tile; selected: true; opacity: 0.9;
    }
}

export component LauncherWindow inherits Window {
    in property <[ResultItem]> results: [];
    in-out property <int> selected-index: 0;
    in-out property <string> current-query: "";
    // Localized text and state are pushed by Rust.
    in property <string> recent-group: "";
    in property <string> pinned-group: "";
    in property <string> pin-label: "";
    in property <string> unpin-label: "";
    /// 搜索区标签与占位文案（UI 复刻轮新增；TS launcher.search.label /
    /// .placeholder，Rust push_launcher_texts 按语言 push）。
    in property <string> search-label: "";
    in property <string> search-placeholder: "";
    /// 首页固定磁贴模型（空查询首页由 Rust push——网格第一行，至多 5 个；
    /// 第二行见 `pinned-tiles-row-2`）。
    in property <[PinnedTile]> pinned-tiles: [];
    /// 固定磁贴网格第二行（至多 5 个，可空）。
    in property <[PinnedTile]> pinned-tiles-row-2: [];
    /// 首页磁贴键盘选中（Rust push 网格下标，-1 = 无选中。高亮与 Enter 执行
    /// 都读它；决策表在 Rust `state::move_tile_selection`）。
    in-out property <int> selected-tile: -1;
    /// "首页功能" 分区头 / 截图按钮文案（Rust 按设置语言 push；分区头不再渲染）。
    in property <string> home-actions-label: "";
    in property <string> home-action-screenshot: "";
    /// 设置齿轮无障碍文案（TS launcher.openSettings；tooltip 层面暂以
    /// accessible 角色提供，UI 复刻轮新增 open-settings 回调配套）。
    in property <string> open-settings-label: "";
    /// 0 system / 1 light / 2 dark（Rust push；与 settings.slint 同语义）。
    in property <int> theme-mode: 0;
    /// M5 Task 3 更新横幅（downloading 纯文本 / downloaded 文本 + "立即安装" /
    /// error checkFailed + 详情 + "查看设置"；其余状态无横幅）。
    in property <string> update-banner-text: "";
    in property <string> update-banner-detail: "";
    in property <bool> update-banner-install: false;
    in property <bool> update-banner-settings: false;
    in property <string> update-banner-install-label: "";
    in property <string> update-banner-settings-label: "";
    callback query-changed(string);
    callback move-selection(int);
    // 首页磁贴四向键盘导航：dx/dy ∈ {-1,0,1}（每次单轴），决策与边界钳制在
    // Rust 侧；撞边界不动、不回绕。
    callback move-tile-selection(int, int);
    callback execute-selected();
    callback dismissed();
    // 固定磁贴点击执行：id 回 Rust 侧 commands_by_id 解析后执行。
    callback run-command-id(string);
    // 首页功能截图入口：与截图热键同一条 start_capture 路径。
    callback run-screenshot();
    // 设置齿轮（UI 复刻轮）：与托盘"设置"同一条 show_settings_window 路径。
    callback open-settings();
    // M2 设置更新桥（Task 9）：入参为 JSON patch 文本，返回空串表示成功、
    // 否则为错误文案。
    callback apply-settings(string) -> string;
    // 固定到首页（M2 Task 10）：command-id 参数；Rust 侧写收藏并刷新视图。
    callback pin-app(string);
    callback move-pinned-app(string, string);
    callback unpin-app(string);
    // M5 Task 3：横幅动作——重启安装已下载的更新 / 打开设置查看更新状态。
    callback install-update();
    callback open-update-settings();

    /// 结果列表滚动偏移别名：Rust 重渲染后复位到顶部——若新旧
    /// selected-index 相同则 changed 不触发，滚动复位必须由 Rust 显式做。
    in-out property <length> results-viewport-y <=> results-list.viewport-y;


    in property <string> keyboard-hint;
    in property <string> empty-hint;
    in property <string> no-results-hint;
    in property <string> home-action-ocr;
    in property <string> hotkey-hint;
    callback run-ocr();
    property <bool> home: root.current-query == "";
    property <bool> home-drag-active: false;
    property <int> gesture-reset: 0;
    public function cancel-home-drag() {
        root.gesture-reset += 1;
        root.home-drag-active = false;
    }
    changed current-query => { root.cancel-home-drag(); }
    // Shared constant keeps scrolling correct when changing result density.
    property <length> result-height: 56px;
    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light
        : root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    function ensure-selection-visible() {
        if root.selected-index < 0 || root.results.length == 0 || results-list.visible-height <= 0px { return; }
        if root.selected-index * root.result-height + results-list.viewport-y < 0px {
            results-list.viewport-y = -root.selected-index * root.result-height;
        } else if (root.selected-index + 1) * root.result-height + results-list.viewport-y > results-list.visible-height {
            results-list.viewport-y = results-list.visible-height - (root.selected-index + 1) * root.result-height;
        }
    }
    init => { root.apply-theme(); }
    changed theme-mode => { root.apply-theme(); }
    changed selected-index => { root.ensure-selection-visible(); }
    title: "CommandCabin";
    preferred-width: 640px;
    min-width: 560px;
    preferred-height: 520px;
    min-height: 520px;
    no-frame: false;
    always-on-top: true;
    icon: @image-url("../assets/icon.png");
    background: CabinTheme.background;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    forward-focus: query-input;
    public function focus-input() { query-input.focus(); }

    VerticalLayout {
        spacing: 0px;
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            vertical-stretch: 1;
            HorizontalLayout {
                height: 30px;
                spacing: 9px;
                Image { width: 27px; height: 27px; source: @image-url("../assets/icon.png"); }
                Text {
                    text: "CommandCabin"; font-size: 14px; font-weight: 600;
                    color: CabinTheme.text; vertical-alignment: center; horizontal-stretch: 1;
                }
                Text { text: root.hotkey-hint; color: CabinTheme.muted; font-size: 11px; vertical-alignment: center; }
                CabinButton {
                    width: 34px; icon-kind: "settings"; label: root.open-settings-label; quiet: true;
                    clicked => { root.open-settings(); }
                }
            }
            Rectangle {
                height: 50px;
                border-radius: 10px;
                border-width: 1px;
                border-color: query-input.has-focus ? CabinTheme.accent : CabinTheme.line;
                background: CabinTheme.background;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 12px; spacing: 11px;
                    VerticalLayout { width: 18px; alignment: center; CabinIcon { kind: "search"; } }
                    query-input := TextInput {
                        text <=> root.current-query;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 15px;
                        color: CabinTheme.text;
                        selection-background-color: CabinTheme.accent;
                        selection-foreground-color: CabinTheme.background;
                        accessible-label: root.search-label;
                        edited => { root.query-changed(self.text); }
                        key-pressed(event) => {
                            if root.home-drag-active {
                                if event.text == Key.Escape { root.cancel-home-drag(); }
                                return accept;
                            }
                            if root.home && root.pinned-tiles.length > 0 {
                                if event.text == Key.UpArrow { root.move-tile-selection(0, -1); return accept; }
                                if event.text == Key.DownArrow { root.move-tile-selection(0, 1); return accept; }
                                if event.text == Key.LeftArrow { root.move-tile-selection(-1, 0); return accept; }
                                if event.text == Key.RightArrow { root.move-tile-selection(1, 0); return accept; }
                            } else {
                                if event.text == Key.UpArrow { root.move-selection(-1); return accept; }
                                if event.text == Key.DownArrow { root.move-selection(1); return accept; }
                            }
                            if event.text == Key.Return { root.execute-selected(); return accept; }
                            if event.text == Key.Escape { root.dismissed(); return accept; }
                            return reject;
                        }
                    }
                    Text { text: "Esc"; font-size: 10px; color: CabinTheme.muted; vertical-alignment: center; }
                }
                if root.home: Text {
                    x: 43px; width: parent.width - 90px; height: parent.height;
                    text: root.search-placeholder; font-size: 15px;
                    color: CabinTheme.muted; overflow: elide; vertical-alignment: center;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.home: VerticalLayout {
                    width: parent.width;
                    spacing: 10px;
                    alignment: start;
                    Text { text: root.pinned-group; font-size: 12px; font-weight: 600; color: CabinTheme.muted; }
                    if root.pinned-tiles.length > 0: PinnedGrid {
                        first-row: root.pinned-tiles; second-row: root.pinned-tiles-row-2;
                        selected: root.selected-tile; unpin-label: root.unpin-label;
                        drag-active <=> root.home-drag-active;
                        gesture-reset: root.gesture-reset;
                        run(id) => { root.run-command-id(id); }
                        unpin(id) => { root.unpin-app(id); }
                        reorder(source, target) => { root.move-pinned-app(source, target); }
                    }
                    if root.pinned-tiles.length == 0: Text {
                        text: root.empty-hint; height: 110px; color: CabinTheme.muted;
                        wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center;
                    }
                    if root.home: VerticalLayout {
                        spacing: 14px;
                        Rectangle { height: 1px; background: CabinTheme.line; }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            CabinButton { icon-kind: "capture"; text: root.home-action-screenshot; clicked => { root.run-screenshot(); } }
                            CabinButton { icon-kind: "text"; text: root.home-action-ocr; clicked => { root.run-ocr(); } }
                        }
                    }
                }
                // Keep ListView alive for Rust's scroll binding, but allocate no home space.
                results-list := ListView {
                    visible: !root.home;
                    width: parent.width;
                    height: root.home ? 0px : parent.height;
                    for item[index] in root.results: Rectangle {
                        height: root.result-height;
                        Rectangle {
                            height: parent.height - 3px; width: parent.width;
                            border-radius: 8px; border-width: 1px;
                            border-color: item.group == "" && index == root.selected-index ? CabinTheme.accent : transparent;
                            background: item.group == "" && index == root.selected-index ? CabinTheme.soft
                            : row-touch.has-hover ? CabinTheme.panel : transparent;
                            row-touch := TouchArea {
                                enabled: item.group == ""; mouse-cursor: pointer;
                                clicked => { root.selected-index = index; root.execute-selected(); }
                            }
                            if item.group != "": Text {
                                x: 12px; height: parent.height; text: item.group; color: CabinTheme.muted;
                                font-size: 11px; font-weight: 600; vertical-alignment: center;
                            }
                            if item.group == "": HorizontalLayout {
                                padding: 10px; spacing: 12px;
                                Rectangle {
                                    width: 32px; height: 32px; border-radius: 8px; background: CabinTheme.panel;
                                    if item.icon.width > 0: Image { x: 3px; y: 3px; width: 26px; height: 26px; source: item.icon; image-fit: contain; }
                                    if item.icon.width == 0: Text { text: item.glyph; color: CabinTheme.accent; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 2px;
                                    Text { text: item.title; color: CabinTheme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                                    if item.subtitle != "": Text { text: item.subtitle; color: CabinTheme.muted; font-size: 11px; overflow: elide; }
                                }
                                if item.app && !item.pinned: CabinButton {
                                    text: root.pin-label; height: 30px;
                                    clicked => { root.pin-app(item.command-id); }
                                }
                            }
                        }
                    }
                }
                if !root.home && root.results.length == 0: Text {
                    width: parent.width; y: parent.height / 2;
                    text: root.no-results-hint; color: CabinTheme.muted; horizontal-alignment: center;
                }
            }
            if root.update-banner-text != "": Rectangle {
                height: 48px; background: CabinTheme.soft; border-radius: 8px;
                HorizontalLayout {
                    padding: 8px; spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: root.update-banner-text; color: CabinTheme.text; font-size: 12px; overflow: elide; }
                        if root.update-banner-detail != "": Text { text: root.update-banner-detail; color: CabinTheme.danger; font-size: 11px; overflow: elide; }
                    }
                    if root.update-banner-install: CabinButton { text: root.update-banner-install-label; clicked => { root.install-update(); } }
                    if root.update-banner-settings: CabinButton { text: root.update-banner-settings-label; clicked => { root.open-update-settings(); } }
                }
            }
        }
        Rectangle {
            height: 34px; background: CabinTheme.panel;
            Rectangle { y: 0px; height: 1px; width: parent.width; background: CabinTheme.line; }
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; spacing: 10px;
                Text { text: root.keyboard-hint; color: CabinTheme.muted; font-size: 10px; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: "Made with Slint"; color: CabinTheme.muted; font-size: 10px; vertical-alignment: center; }
            }
        }
    }
}
