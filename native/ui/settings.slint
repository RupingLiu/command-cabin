// A · 清晰原生：分区设置、单层滚动与固定操作列。
// 输入仍使用双向绑定，回车/失焦提交，经 Rust 原有校验与持久化流程。
import { ComboBox, LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { CabinTheme, CabinButton, CabinIcon, CabinSwitch } from "design.slint";

export struct SettingsTexts {
    shortcuts-nav: string,
    general-title: string,
    data-title: string,
    advanced-title: string,
    general-description: string,
    hotkeys-description: string,
    favorites-description: string,
    data-description: string,
    about-description: string,
    saved-hint: string,

    window-title: string,
    hotkeys-title: string,
    launcher-hotkey-label: string,
    screenshot-hotkey-label: string,
    delayed-hotkey-label: string,
    appearance-title: string,
    theme-label: string,
    theme-system: string,
    theme-light: string,
    theme-dark: string,
    language-title: string,
    language-label: string,
    language-zh-cn: string,
    language-zh-tw: string,
    language-en-us: string,
    startup-title: string,
    launch-at-login: string,
    launcher-title: string,
    hide-on-blur: string,
    preserve-search-query: string,
    max-results: string,
    history-boost: string,
    plugin-boost: string,
    app-boost: string,
    file-boost: string,
    favorites-title: string,
    favorites-empty: string,
    favorites-remove: string,
    clipboard-history-title: string,
    clipboard-history-clear: string,
    about-title: string,
    about-version-text: string,
    about-license: string,
    // M5 Task 3：更新检查 / 下载 / 重启安装按钮文案（settings.about.check /
    // install 逐字；download 为 native 新键）。状态行文本按状态由 Rust 拼装后
    // 经 about-update-status 属性推送。
    about-check: string,
    about-download: string,
    about-install: string,
    back: string,
}

/// 收藏管理行（detail = 类别文案 + 路径/URL；id 供 Rust 侧定位删除目标）。
export struct FavoriteRowView {
    id: string,
    title: string,
    detail: string,
}


component SectionTitle inherits Text {
    font-size: 12px; font-weight: 600; color: CabinTheme.muted;
}
component FormRow inherits Rectangle {
    in property <string> label;
    min-height: 48px;
    border-radius: 8px;
    background: CabinTheme.panel;
    HorizontalLayout {
        padding: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 14px;
        Text { text: root.label; horizontal-stretch: 1; color: CabinTheme.text; font-size: 13px; wrap: word-wrap; vertical-alignment: center; }
        @children
    }
}
component NumberRow inherits FormRow {
    in-out property <string> value;
    callback commit();
    callback edited();
    LineEdit {
        width: 108px; text <=> root.value;
        accessible-label: root.label;
        edited(text) => { root.edited(); }
        accepted(text) => { root.commit(); }
        changed has-focus => { if !self.has-focus { root.commit(); } }
    }
}
component HotkeyRow inherits FormRow {
    in-out property <string> value;
    callback commit();
    callback edited();
    LineEdit {
        width: 200px; text <=> root.value;
        accessible-label: root.label;
        edited(text) => { root.edited(); }
        accepted(text) => { root.commit(); }
        changed has-focus => { if !self.has-focus { root.commit(); } }
    }
}

export component SettingsWindow inherits Window {
    in property <SettingsTexts> texts;
    /// 0 system / 1 light / 2 dark（对齐 cabin-core Theme 三值；Rust push）。
    in property <int> theme-mode: 0;
    /// 收藏列表（Rust 整包 push）。
    in property <[FavoriteRowView]> favorites: [];
    /// 热键 / 数字字段的当前值（Rust 整包 push；与控件两向绑定）。
    in-out property <string> hotkey-launcher: "";
    in-out property <string> hotkey-screenshot: "";
    in-out property <string> hotkey-delayed: "";
    in-out property <string> max-results: "";
    in-out property <string> history-boost: "";
    in-out property <string> plugin-boost: "";
    in-out property <string> app-boost: "";
    in-out property <string> file-boost: "";
    in-out property <bool> hide-on-blur: false;
    in-out property <bool> launch-at-login: false;
    in-out property <bool> preserve-search-query: false;
    /// ComboBox 当前项（与控件两向绑定；用户选择经 selected 提交）。
    in-out property <int> theme-choice: 0;
    in-out property <int> language-choice: 0;
    /// 最近一次提交的错误文案（空 = 无错误）。提交失败时 Rust 侧会重推视图，
    /// 输入框/选择回到生效值；错误保留到下一次提交。
    in-out property <string> error-text: "";
    /// 清空剪贴板历史的失败提示（M4 Task 7；空 = 无错误，TS 成功态无消息）。
    in-out property <string> clipboard-clear-status: "";
    /// M5 Task 3 更新状态行（Rust 按状态机 + 语言拼装：空闲提示 / 正在检查 /
    /// 发现新版本 + 说明摘要 / 下载进度 / 已下载 / 最新 / 可读错误）。
    in property <string> about-update-status: "";
    /// TS canCheck：非忙态且未就绪待安装时可点"检查更新"（debug 构建恒 false）。
    in property <bool> can-check-update: false;
    /// available 停留态：显示"下载"钮（TS 自动下载无此态，M5 计划新增）。
    in property <bool> can-download-update: false;
    /// TS canInstall：已下载且版本一致 → 显示"重启安装"钮。
    in property <bool> can-install-update: false;

    callback commit-hotkey(int) -> string;
    callback commit-number(int) -> string;
    callback set-switch(int, bool) -> string;
    callback set-choice(int, int) -> string;
    callback remove-favorite(int);
    callback clear-clipboard-history();
    // M5 Task 3：更新编排入口（手动检查 / 下载 / 重启安装），全部回 Rust 侧。
    callback check-updates();
    callback download-update();
    callback install-update();
    callback dismissed();


    in-out property <int> active-page: 0;
    private property <int> pending-kind: -1;
    private property <int> pending-field: -1;
    // A conditional page can be destroyed before deferred focus-change handlers
    // run. Commit its edited field explicitly before navigation or closing.
    public function commit-pending() {
        let kind = root.pending-kind;
        let field = root.pending-field;
        root.pending-kind = -1;
        root.pending-field = -1;
        if kind == 0 { root.error-text = root.commit-hotkey(field); }
        if kind == 1 { root.error-text = root.commit-number(field); }
    }
    function commit-field(kind: int, field: int) {
        if root.pending-kind == kind && root.pending-field == field { root.commit-pending(); }
    }

    private property <bool> advanced: false;
    private property <[string]> page-titles: [root.texts.general-title, root.texts.hotkeys-title, root.texts.favorites-title, root.texts.data-title, root.texts.about-title];
    private property <[string]> page-descriptions: [root.texts.general-description, root.texts.hotkeys-description, root.texts.favorites-description, root.texts.data-description, root.texts.about-description];
    private property <[string]> page-icons: ["settings", "keyboard", "star", "data", "about"];
    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light
        : root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    init => { root.apply-theme(); }
    changed theme-mode => { root.apply-theme(); }
    changed active-page => { content-scroll.viewport-y = 0px; }
    title: root.texts.window-title;
    preferred-width: 720px; min-width: 680px;
    preferred-height: 550px; min-height: 500px;
    icon: @image-url("../assets/icon.png");
    background: CabinTheme.background;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;
            Rectangle {
                width: 150px;
                background: CabinTheme.panel;
                Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: CabinTheme.line; }
                VerticalLayout {
                    padding: 12px; padding-top: 22px; spacing: 6px;
                    HorizontalLayout {
                        height: 37px; spacing: 9px;
                        Image { width: 25px; height: 25px; source: @image-url("../assets/icon.png"); }
                        Text { text: root.texts.window-title; color: CabinTheme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                    }
                    for title[index] in root.page-titles: CabinButton {
                        text: index == 1 ? root.texts.shortcuts-nav : title; icon-kind: root.page-icons[index]; quiet: true;
                        min-width: 0px;
                        selected: root.active-page == index; height: 39px;
                        clicked => { root.commit-pending(); root.active-page = index; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            VerticalLayout {
                padding: 24px; spacing: 10px;
                Text { text: root.page-titles[root.active-page]; font-size: 22px; font-weight: 600; color: CabinTheme.text; }
                Text { text: root.page-descriptions[root.active-page]; font-size: 12px; color: CabinTheme.muted; wrap: word-wrap; }
                Rectangle { height: 6px; }
                content-scroll := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-right: 8px; spacing: 7px; alignment: start;
                        if root.active-page == 0: VerticalLayout {
                            spacing: 8px; alignment: start;
                            SectionTitle { text: root.texts.appearance-title; }
                            FormRow {
                                label: root.texts.theme-label;
                                theme-combo := ComboBox {
                                    width: 155px;
                                    model: [root.texts.theme-system, root.texts.theme-light, root.texts.theme-dark];
                                    current-index <=> root.theme-choice;
                                    accessible-label: root.texts.theme-label;
                                    selected(v) => { root.error-text = root.set-choice(0, theme-combo.current-index); }
                                }
                            }
                            FormRow {
                                label: root.texts.language-label;
                                language-combo := ComboBox {
                                    width: 155px;
                                    model: [root.texts.language-zh-cn, root.texts.language-zh-tw, root.texts.language-en-us];
                                    current-index <=> root.language-choice;
                                    accessible-label: root.texts.language-label;
                                    selected(v) => { root.error-text = root.set-choice(1, language-combo.current-index); }
                                }
                            }
                            Rectangle { height: 6px; }
                            SectionTitle { text: root.texts.launcher-title; }
                            FormRow {
                                label: root.texts.launch-at-login;
                                CabinSwitch { checked <=> root.launch-at-login; label: root.texts.launch-at-login; toggled => { root.error-text = root.set-switch(1, root.launch-at-login); } }
                            }
                            FormRow {
                                label: root.texts.hide-on-blur;
                                CabinSwitch { checked <=> root.hide-on-blur; label: root.texts.hide-on-blur; toggled => { root.error-text = root.set-switch(0, root.hide-on-blur); } }
                            }
                            FormRow {
                                label: root.texts.preserve-search-query;
                                CabinSwitch { checked <=> root.preserve-search-query; label: root.texts.preserve-search-query; toggled => { root.error-text = root.set-switch(2, root.preserve-search-query); } }
                            }
                            CabinButton {
                                text: (root.advanced ? "−  " : "+  ") + root.texts.advanced-title; quiet: true;
                                selected: root.advanced;
                                clicked => { root.commit-pending(); root.advanced = !root.advanced; }
                            }
                            if root.advanced: VerticalLayout {
                                spacing: 5px;
                                NumberRow { label: root.texts.max-results; value <=> root.max-results; edited => { root.pending-kind = 1; root.pending-field = 0; } commit => { root.commit-field(1, 0); } }
                                NumberRow { label: root.texts.history-boost; value <=> root.history-boost; edited => { root.pending-kind = 1; root.pending-field = 1; } commit => { root.commit-field(1, 1); } }
                                NumberRow { label: root.texts.plugin-boost; value <=> root.plugin-boost; edited => { root.pending-kind = 1; root.pending-field = 2; } commit => { root.commit-field(1, 2); } }
                                NumberRow { label: root.texts.app-boost; value <=> root.app-boost; edited => { root.pending-kind = 1; root.pending-field = 3; } commit => { root.commit-field(1, 3); } }
                                NumberRow { label: root.texts.file-boost; value <=> root.file-boost; edited => { root.pending-kind = 1; root.pending-field = 4; } commit => { root.commit-field(1, 4); } }
                            }
                        }
                        if root.active-page == 1: VerticalLayout {
                            spacing: 8px;
                            HotkeyRow { label: root.texts.launcher-hotkey-label; value <=> root.hotkey-launcher; edited => { root.pending-kind = 0; root.pending-field = 0; } commit => { root.commit-field(0, 0); } }
                            HotkeyRow { label: root.texts.screenshot-hotkey-label; value <=> root.hotkey-screenshot; edited => { root.pending-kind = 0; root.pending-field = 1; } commit => { root.commit-field(0, 1); } }
                            HotkeyRow { label: root.texts.delayed-hotkey-label; value <=> root.hotkey-delayed; edited => { root.pending-kind = 0; root.pending-field = 2; } commit => { root.commit-field(0, 2); } }
                        }
                        if root.active-page == 2: VerticalLayout {
                            spacing: 1px;
                            if root.favorites.length == 0: Text { text: root.texts.favorites-empty; color: CabinTheme.muted; height: 120px; vertical-alignment: center; horizontal-alignment: center; }
                            for favorite[index] in root.favorites: Rectangle {
                                height: 66px;
                                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: CabinTheme.line; }
                                HorizontalLayout {
                                    padding-top: 10px; padding-bottom: 10px; spacing: 12px;
                                    VerticalLayout { width: 18px; alignment: center; CabinIcon { kind: "star"; } }
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 4px; alignment: center;
                                        Text { text: favorite.title; font-size: 13px; font-weight: 600; color: CabinTheme.text; overflow: elide; }
                                        Text { text: favorite.detail; font-size: 11px; color: CabinTheme.muted; overflow: elide; }
                                    }
                                    CabinButton { width: 70px; text: root.texts.favorites-remove; clicked => { root.remove-favorite(index); } }
                                }
                            }
                        }
                        if root.active-page == 3: VerticalLayout {
                            spacing: 12px;
                            FormRow {
                                label: root.texts.clipboard-history-title;
                                CabinButton { text: root.texts.clipboard-history-clear; clicked => { root.clear-clipboard-history(); } }
                            }
                            if root.clipboard-clear-status != "": Text { text: root.clipboard-clear-status; color: CabinTheme.danger; wrap: word-wrap; }
                        }
                        if root.active-page == 4: VerticalLayout {
                            spacing: 16px; alignment: start;
                            Image { width: 48px; height: 48px; source: @image-url("../assets/icon.png"); }
                            Text { text: root.texts.about-version-text; color: CabinTheme.text; font-size: 17px; font-weight: 600; }
                            Text { text: root.about-update-status; color: CabinTheme.muted; font-size: 13px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                CabinButton { text: root.texts.about-check; enabled: root.can-check-update; clicked => { root.check-updates(); } }
                                if root.can-download-update: CabinButton { text: root.texts.about-download; clicked => { root.download-update(); } }
                                if root.can-install-update: CabinButton { text: root.texts.about-install; clicked => { root.install-update(); } }
                            }
                            Rectangle { height: 1px; background: CabinTheme.line; }
                            Text { text: "Made with Slint"; color: CabinTheme.muted; font-size: 12px; }
                            Text { text: root.texts.about-license; color: CabinTheme.muted; font-size: 11px; wrap: word-wrap; }
                        }
                    }
                }
                if root.error-text != "": Text { text: root.error-text; font-size: 12px; color: CabinTheme.danger; wrap: word-wrap; }
            }
        }
        Rectangle {
            height: 48px; background: CabinTheme.panel;
            Rectangle { y: 0px; height: 1px; width: parent.width; background: CabinTheme.line; }
            HorizontalLayout {
                padding-left: 18px; padding-right: 18px; spacing: 12px;
                Text { text: root.texts.saved-hint; color: CabinTheme.muted; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                VerticalLayout { width: 80px; alignment: center; CabinButton { width: 80px; text: root.texts.back; quiet: true; centered: true; clicked => { root.dismissed(); } } }
            }
        }
    }
}
